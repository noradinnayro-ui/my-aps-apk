rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.completedFocusSessions is int &&
             data.completedFocusSessions >= 0 &&
             data.completedFocusSessions <= 100000 &&
             data.totalFocusMinutes is int &&
             data.totalFocusMinutes >= 0 &&
             data.totalFocusMinutes <= 10000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidSavedConfig(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 80 &&
             data.jsonContent is string &&
             data.jsonContent.size() >= 2 &&
             data.jsonContent.size() <= 50000 &&
             data.keysCount is int &&
             data.keysCount >= 0 &&
             data.keysCount <= 500 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidFocusSession(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.presetName is string &&
             data.presetName.size() >= 1 &&
             data.presetName.size() <= 40 &&
             data.durationMinutes is int &&
             data.durationMinutes >= 1 &&
             data.durationMinutes <= 180 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidActiveTimerState(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.taskName is string &&
             data.taskName.size() <= 120 &&
             data.presetName is string &&
             data.presetName.size() >= 1 &&
             data.presetName.size() <= 40 &&
             data.phase is string &&
             data.phase in ['FOCUS', 'BREAK'] &&
             data.totalSeconds is int &&
             data.totalSeconds >= 60 &&
             data.totalSeconds <= 10800 &&
             data.remainingSeconds is int &&
             data.remainingSeconds >= 0 &&
             data.remainingSeconds <= data.totalSeconds &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'completedFocusSessions', 'totalFocusMinutes', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'completedFocusSessions', 'totalFocusMinutes', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'completedFocusSessions', 'totalFocusMinutes', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /configs/{configId} {
        allow get: if isOwner(userId) && isValidId(configId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(configId) &&
                         incoming().keys().hasAll(['userId', 'title', 'jsonContent', 'keysCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'jsonContent', 'keysCount', 'createdAt', 'updatedAt']) &&
                         isValidSavedConfig(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(configId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSavedConfig(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'jsonContent', 'keysCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(configId);
      }

      match /focus_sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll(['userId', 'presetName', 'durationMinutes', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'presetName', 'durationMinutes', 'createdAt']) &&
                         isValidFocusSession(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /active_timer/{timerId} {
        allow get: if isOwner(userId) && isValidId(timerId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(timerId) &&
                         incoming().keys().hasAll(['userId', 'taskName', 'presetName', 'phase', 'totalSeconds', 'remainingSeconds', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'taskName', 'presetName', 'phase', 'totalSeconds', 'remainingSeconds', 'createdAt', 'updatedAt']) &&
                         isValidActiveTimerState(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(timerId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidActiveTimerState(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['taskName', 'presetName', 'phase', 'totalSeconds', 'remainingSeconds', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(timerId);
      }
    }
  }
}
